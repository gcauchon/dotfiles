# Declarative package list. Usage (from repo root):
#   brew bundle --file=Brewfile            # install everything
#   brew bundle check --file=Brewfile      # report what's missing
#   brew bundle cleanup --file=Brewfile    # list installed packages not in this file (--force to remove)

